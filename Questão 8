programa {
  funcao inicio() {

    inteiro i, numero, positivos, negativos, zeros

    positivos = 0
    negativos = 0
    zeros = 0

    para (i = 1; i <= 20; i++) {
      escreva("Digite um número: ")
      leia(numero)

      se (numero > 0) {
        positivos = positivos + 1
      } senao se (numero < 0) {
        negativos = negativos + 1
      } senao {
        zeros = zeros + 1
      }
    }

    escreva("\nPositivos: ", positivos)
    escreva("\nNegativos: ", negativos)
    escreva("\nZeros: ", zeros)
  }
}
